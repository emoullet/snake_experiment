<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>snake_experiment_ui</name>
  <version>0.1.0</version>
  <description>Operator web interface for Snake experiment calibration.</description>

  <maintainer email="etienne.moullet@gmail.com">Etienne Moullet</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cartesian_manager</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>explorer_bringup</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joystick_mapper</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-jinja2</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>qontrol_controller</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-httpx</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
